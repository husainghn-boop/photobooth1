# Supabase Configuration Template
# Copy this file to .env.local and fill in your actual values

# Your Supabase project URL
# Found in: https://app.supabase.com/ → Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous key (public/publishable key)
# Found in: https://app.supabase.com/ → Settings > API > Project API keys > anon/public
# IMPORTANT: This is the PUBLIC key (anon key), safe to expose in frontend code
# IMPORTANT: NEVER use the service_role key (that's server-side only)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
